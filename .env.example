# ============================================================
# SECRETS / PASSWORDS - simple dev values (not for production)
# ============================================================

# Core Airflow encryption key (Fernet - MUST remain a valid base64 32-byte
# token; regenerable with `python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"`).
FERNET_KEY=

# Airflow API auth JWT secret
AIRFLOW__API_AUTH__JWT_SECRET=

# Airflow API session/CSRF secret
AIRFLOW__API__SECRET_KEY=

# Airflow web UI / CLI admin password (username defaults to "airflow")
_AIRFLOW_WWW_USER_PASSWORD=

# MongoDB admin credentials. Used to create the admin user during replica set
# bootstrap and by clients (Spark writer, mongo-express, mongosh) to authenticate.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=

# Mongo Express web-UI login (separate from DB auth)
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=

# ============================================================
# SHARED TOPOLOGY NAMES (changeable, overridable)
# ============================================================

# Kafka broker addresses (internal Docker DNS). Comma-separated multiple
# brokers so clients fall back to a healthy broker if one is down.
KAFKA_BOOTSTRAP_SERVERS=broker1:9092,broker2:9092

# Topic produced by kafka_stream.py and consumed by spark_stream.py
KAFKA_TOPIC=users_created

# How long the producer runs per DAG run (seconds)
PIPELINE_DURATION=60

# Confluent Schema Registry (Avro data contract for the topic)
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ============================================================
# HOST / TUNING (options, dev defaults)
# ============================================================

# UID of the host user for correct file ownership in Airflow containers
AIRFLOW_UID=1000

# Extra pip requirements installed into the Airflow image at startup
_PIP_ADDITIONAL_REQUIREMENTS=
